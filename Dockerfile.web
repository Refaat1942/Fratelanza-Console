FROM node:24-slim AS base
RUN npm install -g pnpm@10
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY lib/api-spec/package.json ./lib/api-spec/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/outline-utils/package.json ./lib/outline-utils/
COPY lib/db/package.json ./lib/db/
COPY artifacts/fratelanza/package.json ./artifacts/fratelanza/
RUN pnpm install --no-frozen-lockfile

FROM deps AS builder
COPY lib/ ./lib/
COPY artifacts/fratelanza/ ./artifacts/fratelanza/
COPY tsconfig.json tsconfig.base.json ./
ARG VITE_BASE_URL=/
ENV VITE_BASE_URL=${VITE_BASE_URL}
ENV PORT=3000
ENV BASE_PATH=/
RUN pnpm --filter @workspace/fratelanza run build

FROM nginx:alpine AS runner
COPY --from=builder /app/artifacts/fratelanza/dist/public /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
